{
  "name": "Nout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "generate:og": "node scripts/generate-og-image.mjs",
    "prebuild": "pnpm generate:og",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm test:firebase",
    "test:firebase": "firebase emulators:exec --project demo-nout --only auth,firestore \"vitest run --config vitest.firebase.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.1",
    "@mui/material": "^7.1.1",
    "@tiptap/core": "^3.27.1",
    "@tiptap/extension-code-block-lowlight": "^3.11.1",
    "@tiptap/extension-highlight": "^3.10.1",
    "@tiptap/extension-typography": "^3.10.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.10.1",
    "@tiptap/starter-kit": "^3.10.1",
    "firebase": "^12.16.0",
    "lowlight": "^3.3.0",
    "material-ui-popup-state": "^5.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "firebase-tools": "^15.25.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "packageManager": "pnpm@11.9.0"
}
